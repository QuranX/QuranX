@using QuranX.Web.Views.HadithIndex
@using QuranX.Web.Views.Shared
@model HadithsViewModel

@{
    await Html.RenderPartialAsync("HadithIndexHeader", Model.HadithIndexHeaderViewModel);
    if (@Model.Hadiths.Count() != 1)
    {
        <h4 class="hadith__reference-count">@Model.Hadiths.Count() @ViewBag.Title</h4>
    }
}
@{
    foreach (HadithViewModel hadithVM in Model.Hadiths)
    {
        await Html.RenderPartialAsync("HadithView", hadithVM);
    }
}
@{
    await Html.RenderPartialAsync("Adverts");
}
