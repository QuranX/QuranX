@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Html
@using QuranX.Web.Extensions

@{
    var request = httpContextAccessor.HttpContext.Request;
    string currentUrl = $"https://quranx.com{request.Path}";
    if (ViewBag.Canonical is null)
    {
        ViewBag.Canonical = currentUrl;
    }
    else
    {
        ViewBag.Canonical = $"{request.Scheme}://{request.Host}{ViewBag.Canonical}";
    }
    ViewBag.Canonical = Html.RemoveTrailingSlash((string)ViewBag.Canonical);

    string metaDescription = $"{ViewBag.Title} - QuranX.com The most complete Quran / Hadith / Tafsir collection available!";
}
<!DOCTYPE html>
<html>
<head>
    <script>document.documentElement.className += " js";</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/bootstrap.css" asp-append-version=true />
    <link rel="stylesheet" href="/site.css" asp-append-version=true />
    <link rel="canonical" href="@ViewBag.Canonical" />
    <meta name="description" content="@metaDescription">
    @(new HtmlString(ViewBag.PageHeaders))
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-680HEFB03Z"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-680HEFB03Z');
    </script>
    <script src="/Scripts/jquery-3.3.1.js" asp-append-version=true></script>
    <script src="/Scripts/jquery.highlight.js" asp-append-version=true></script>
    <script src="/Scripts/jquery.validate.js" asp-append-version=true></script>
    <script src="/Scripts/modernizr-2.8.3.js" asp-append-version=true></script>
    <script src="/Scripts/bootstrap.js" asp-append-version=true></script>
    <script src="/Scripts/quranx.verse-counts.js" asp-append-version=true></script>

    <meta property="og:image" content="https://quranx.com/Images/QuranXSocialIcon.png" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:url" content="@(currentUrl.TrimEnd('/'))" />
    <meta property="og:type" content="article" />
    <meta property="og:description" content="@metaDescription" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewBag.Title" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="https://quranx.com/Images/QuranXSocialIcon.png" />


    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
</head>
<body>
    @{
        await Html.RenderPartialAsync("Socials");
    }
    <div id="donate-container" href="https://www.patreon.com/QuranX">
        <a href="https://www.patreon.com/QuranX" class="quranx navbar-brand">
            <img class="subhan-Allah" src="/Images/SubhanAllah.png" alt="Donate" />
            <div class="donate-text">
                Donate
            </div>
        </a>
    </div>
    <div class="quranx navbar navbar-inverse navbar-fixed-top">
        <div>
            <div class="quranx navbar-header">
                <button type="button" class="quranx navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    MENU
                </button>
                <a href="/1.1" class="quranx navbar-brand">Quran</a>
            </div>
            <div class="quranx navbar-collapse collapse">
                <ul class="quranx nav navbar-nav">
                    <li>@Html.RouteLink("Tafsirs", "Commentators")</li>
                    <li>@Html.RouteLink("Hadiths", "HadithCollections")</li>
                    <li>@Html.RouteLink("Search", "SiteSearch")</li>
                    <li>@Html.RouteLink("Dictionaries", "Dictionaries", new { Root = (string)null })</li>
                    <li>@Html.RouteLink("Help", "Help")</li>
                    <li>@Html.RouteLink("About", "About")</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="container-fluid body-content pt">
        @RenderBody()
    </div>
    <script src="/Scripts/quranx.autohighlight.js" asp-append-version=true></script>
    <script src="/Scripts/quranx.verse-translations.js" asp-append-version=true></script>
    <script src="/Scripts/quranx.hash-url-fixer.js" asp-append-version=true></script>
</body>
</html>
